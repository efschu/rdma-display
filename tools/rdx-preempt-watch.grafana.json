{
 "uid": "rdx-preempt-watch",
 "title": "Preemption mode – benefit and cost",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "tags": [
  "rdma-display",
  "kernel"
 ],
 "panels": [
  {
   "type": "state-timeline",
   "title": "Preemption mode",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "none",
         "color": "purple"
        },
        "1": {
         "text": "voluntary",
         "color": "orange"
        },
        "2": {
         "text": "full",
         "color": "green"
        },
        "3": {
         "text": "lazy",
         "color": "blue"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "showValue": "auto",
    "legend": {
     "showLegend": true
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "max without (mode) (rdx_preempt_mode_code)",
     "legendFormat": "mode",
     "refId": "A",
     "interval": "1m"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Wake-up latency, SCHED_FIFO 80 (cyclictest, 1 ms, per minute)",
   "description": "Benefit: how late a real-time thread wakes. Alarm above 4 ms.",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "max without (mode) (rdx_preempt_wake_rt_max_us) / 1000",
     "legendFormat": "max",
     "refId": "A",
     "interval": "1m"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "max without (mode) (rdx_preempt_wake_rt_p99_us) / 1000",
     "legendFormat": "p99",
     "refId": "B",
     "interval": "1m"
    }
   ]
  },
