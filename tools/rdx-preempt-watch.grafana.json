  {
   "type": "timeseries",
   "title": "Host CPU % (node_exporter, also before the watcher)",
   "description": "Cost. History from node_exporter, so voluntary periods are visible too.",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum(rate(node_cpu_seconds_total{instance=\"$instance\",mode=\"system\"}[2m])) / sum(rate(node_cpu_seconds_total{instance=\"$instance\"}[2m])) * 100",
     "legendFormat": "sys",
     "refId": "A",
     "interval": "1m"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum(rate(node_cpu_seconds_total{instance=\"$instance\",mode=\"softirq\"}[2m])) / sum(rate(node_cpu_seconds_total{instance=\"$instance\"}[2m])) * 100",
     "legendFormat": "softirq",
     "refId": "B",
     "interval": "1m"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum(rate(node_cpu_seconds_total{instance=\"$instance\",mode=\"irq\"}[2m])) / sum(rate(node_cpu_seconds_total{instance=\"$instance\"}[2m])) * 100",
     "legendFormat": "irq",
     "refId": "C",
     "interval": "1m"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum(rate(node_cpu_seconds_total{instance=\"$instance\",mode=\"iowait\"}[2m])) / sum(rate(node_cpu_seconds_total{instance=\"$instance\"}[2m])) * 100",
     "legendFormat": "iowait",
     "refId": "D",
     "interval": "1m"
    }
   ]
  },
