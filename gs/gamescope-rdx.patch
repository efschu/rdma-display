+	class CRdxBackend final : public CBaseBackend
+	{
+	public:
+		explicit CRdxBackend( bool bStream = false ) : m_Connector( this ), m_bStream( bStream ) {}
+
+		virtual ~CRdxBackend()
+		{
+			m_bRunning = false;
+			if ( m_nSocket >= 0 )
+				shutdown( m_nSocket, SHUT_RDWR );
+			m_StreamCv.notify_all();
+			if ( m_RecvThread.joinable() )
+				m_RecvThread.join();
+			if ( m_StreamThread.joinable() )
+				m_StreamThread.join();
+			if ( m_nInputStop[ 1 ] >= 0 && write( m_nInputStop[ 1 ], "x", 1 ) != 1 )
+				rdx_log.errorf_errno( "stopping the input thread" );
+			if ( m_InputThread.joinable() )
+				m_InputThread.join();
+			for ( uint32_t i = 0; i < RDX_GS_MAX_SLOTS; i++ )
+				if ( m_pHostMap[ i ] )
+					munmap( m_pHostMap[ i ], m_Hello.slot_size );
+		}
+
+		virtual bool Init() override
+		{
+			const char *pszPath = getenv( "RDX_GS_SOCKET" );
+			if ( !pszPath )
+			{
+				fprintf( stderr, "rdx backend: RDX_GS_SOCKET is not set (start gamescope through rdx_gs_src)\n" );
+				return false;
+			}
+			if ( !Connect( pszPath, false ) )
+				return false;
+			s_pRdxBackend = this;
+
+			g_nOutputWidth = m_Hello.width;
+			g_nOutputHeight = m_Hello.height;
+			// the client's exact refresh: our vblank timer runs on its grid (variable refresh: the cap)
+			g_nOutputRefresh = m_Hello.refresh_mhz;
+			g_nNestedRefresh = m_Hello.refresh_mhz;
+			UpdateVrr();
+			if ( g_nPreferredOutputWidth && ( (uint32_t)g_nPreferredOutputWidth != m_Hello.width ||
+			                                   (uint32_t)g_nPreferredOutputHeight != m_Hello.height ) )
+				rdx_log.infof( "-W/-H %dx%d ignored, the client mode is %ux%u", g_nPreferredOutputWidth,
+				               g_nPreferredOutputHeight, m_Hello.width, m_Hello.height );
+
+			if ( !vulkan_init( vulkan_get_instance(), VK_NULL_HANDLE ) )
+				return false;
+
+			if ( !ImportSlots() )
+				return false;
+
+			if ( !wlsession_init() )
+			{
+				fprintf( stderr, "Failed to initialize Wayland session\n" );
+				return false;
+			}
+
+			m_RecvThread = std::thread( [this]() { RecvThread(); } );
+
+			// input: like headless there is no window to take it from. Read the seat's devices
+			// with gamescope's own libinput handler, but only virtual devices (rdx_input_rx's mirrors
+			// of the client's keyboard/mouse, a local window's, Steam Input, uhid) and USB/IP.
+			{
+				extern bool g_bRdxOnlyRdxDevices;
+				const char *pszInput = getenv( "RDX_GS_INPUT" );
+				g_bRdxOnlyRdxDevices = !( pszInput && !strcmp( pszInput, "all" ) );
+				rdx_log.infof( "input: %s", g_bRdxOnlyRdxDevices ? "virtual devices and USB/IP only, not this host's own keyboard/mouse"
+				                                                  : "every device of the seat (RDX_GS_INPUT=all)" );
+			}
+			// and the seat "seat-rdx": the client's devices of a gamescope session and a local window's
+			// are for this gamescope only, no desktop reads that seat (rdma-display
+			// common/rdx_input.h RDX_INPUT_PRIVATE_*, desktop/72-rdma-display-input.rules)
+			m_pLibInput = std::make_unique<CLibInputHandler>();
+			m_pLibInputPrivate = std::make_unique<CLibInputHandler>();
+			const bool bSeat0 = m_pLibInput->Init( "seat0" );
+			const bool bPrivate = m_pLibInputPrivate->Init( "seat-rdx" );
+			if ( !bSeat0 )
+				m_pLibInput = nullptr;
+			if ( !bPrivate )
+				m_pLibInputPrivate = nullptr;
+			if ( ( bSeat0 || bPrivate ) && pipe2( m_nInputStop, O_CLOEXEC ) == 0 &&
+			     pipe2( m_nInputWake, O_CLOEXEC | O_NONBLOCK ) == 0 )
+				m_InputThread = std::thread( [this]() { InputThread(); } );
+			else
+				rdx_log.errorf( "no libinput on seat0 or seat-rdx: input from the client will not reach the app" );
+			return true;
+		}
+
+		virtual bool PostInit() override { return true; }
+
+		virtual std::span<const char *const> GetInstanceExtensions() const override { return std::span<const char *const>{}; }
+		virtual std::span<const char *const> GetDeviceExtensions( VkPhysicalDevice pVkPhysicalDevice ) const override
+		{
+			// VRAM buffers need the opaque fd import, host buffers VK_EXT_external_memory_host, host
+			// buffers handed over as dma-bufs (RDX_GS_FLAG_DMABUF) VK_EXT_external_memory_dma_buf
+			static const char *const s_Exts[] = { VK_KHR_EXTERNAL_MEMORY_FD_EXTENSION_NAME, VK_EXT_EXTERNAL_MEMORY_HOST_EXTENSION_NAME };
+			static const char *const s_DmabufExts[] = { VK_KHR_EXTERNAL_MEMORY_FD_EXTENSION_NAME, VK_EXT_EXTERNAL_MEMORY_DMA_BUF_EXTENSION_NAME };
+			if ( m_Hello.buf_kind == RDX_GS_BUF_HOST && ( m_Hello.flags & RDX_GS_FLAG_DMABUF ) )
+				return std::span<const char *const>{ s_DmabufExts, 2u };
+			return std::span<const char *const>{ s_Exts, m_Hello.buf_kind == RDX_GS_BUF_HOST ? 2u : 1u };
+		}
+		virtual VkImageLayout GetPresentLayout() const override { return VK_IMAGE_LAYOUT_GENERAL; }
+		virtual void GetPreferredOutputFormat( uint32_t *pPrimaryPlaneFormat, uint32_t *pOverlayPlaneFormat ) const override
+		{
+			*pPrimaryPlaneFormat = VulkanFormatToDRM( VK_FORMAT_B8G8R8A8_UNORM );
+			*pOverlayPlaneFormat = VulkanFormatToDRM( VK_FORMAT_B8G8R8A8_UNORM );
+		}
+		virtual bool ValidPhysicalDevice( VkPhysicalDevice pVkPhysicalDevice ) const override
+		{
+			// composite on the GPU rdx_gs_src chose (VRAM buffers live there)
+			VkPhysicalDeviceIDProperties idProps = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES };
+			VkPhysicalDeviceProperties2 props = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, .pNext = &idProps };
+			g_device.vk.GetPhysicalDeviceProperties2( pVkPhysicalDevice, &props );
+			if ( memcmp( idProps.deviceUUID, m_Hello.gpu_uuid, VK_UUID_SIZE ) != 0 )
+			{
+				rdx_log.errorf( "Vulkan picked %s, but rdx_gs_src chose another GPU "
+				                "(it passes --prefer-vk-device for it)", props.properties.deviceName );
+				return false;
+			}
+			rdx_log.infof( "compositing on %s (%s buffers)", props.properties.deviceName,
+			               m_Hello.buf_kind == RDX_GS_BUF_HOST ? "host" : "VRAM" );
+			return true;
+		}
+
+		virtual void DirtyState( bool bForce, bool bForceModeset ) override {}
+		virtual bool PollState() override { return false; }
