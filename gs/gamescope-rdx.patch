+// rdma-display: an absolute pointer (libinput, the client's uinput tablet-style mouse) as a position 0..1
+// over the whole output, mapped like a touch: output pixels, then the focused window's offset and scale,
+// clamped to the surface. wlserver_mousewarp( raw device mm ) is only right if the device range happens
+// to equal the focused surface.
+void wlserver_mousewarp_normalized( double flNormX, double flNormY, uint32_t time )
+{
+	assert( wlserver_is_lock_held() );
+
+	if ( wlserver.mouse_focus_surface == NULL )
+		return;
+
+	double tx = flNormX * g_nOutputWidth;
+	double ty = flNormY * g_nOutputHeight;
+	tx += focusedWindowOffsetX;
+	ty += focusedWindowOffsetY;
+	tx *= focusedWindowScaleX;
+	ty *= focusedWindowScaleY;
+
+	auto [nWidth, nHeight] = wlserver_get_cursor_bounds();
+	tx = clamp( tx, 0.0, nWidth - 0.1 );
+	ty = clamp( ty, 0.0, nHeight - 0.1 );
+
+	wlserver_mousewarp( tx, ty, time, false );   /* a real device moved: the cursor shows again */
+}
+
+// rdma-display (the cursor next to the picture): where the hotspot is on the focused surface, like
+// MouseCursor::UpdatePosition (a constraint's cursor hint wins), and whether the cursor shows; lock held
+void wlserver_cursor_state( double *pX, double *pY, bool *pVisible )
+{
+	assert( wlserver_is_lock_held() );
+
+	*pX = wlserver.mouse_surface_cursorx;
+	*pY = wlserver.mouse_surface_cursory;
+	struct wlr_pointer_constraint_v1 *pConstraint = wlserver.GetCursorConstraint();
+	if ( pConstraint && pConstraint->current.cursor_hint.enabled )
+	{
+		*pX = pConstraint->current.cursor_hint.x;
+		*pY = pConstraint->current.cursor_hint.y;
+	}
+	*pVisible = !wlserver.bCursorHidden && wlserver.bCursorHasImage;
+}
