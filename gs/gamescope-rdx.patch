+// rdma-display: "no upscaling for ordinary windows" (default on, RDX_GS_NOUPSCALE=0 restores gamescope's
+// auto scaler). gamescope's auto scaler fits every focused window to the output and magnifies it as far
+// as it goes, which is right for a game that renders below the output size but wrong for a desktop-style
+// window (a launcher's login dialog): that comes out blurred and several times its size.
+//
+// The two are told apart by how the app declares itself, not by its size alone: a game that renders below
+// the output is fullscreen (_NET_WM_STATE_FULLSCREEN, Wine and SDL set it for a fullscreen mode, with a
+// mode change too), or has been made as large as the root window (force_windows_fullscreen, Xwayland's
+// resolution emulation: window = root, buffer smaller), or is Steam; those keep the auto scaler and are
+// magnified to the output as before. Everything else that is an X11 toplevel is a plain window and
+// is shown 1:1 in the centre if it is not larger than the output (larger ones are fitted down as before).
+// Native Wayland clients are left as they were (gamescope sizes those itself).
+static bool window_is_plain_window( steamcompmgr_win_t *w )
+{
+	static const bool s_bEnabled = []{ const char *e = getenv( "RDX_GS_NOUPSCALE" ); return !( e && !strcmp( e, "0" ) ); }();
+	if ( !s_bEnabled || !w || w->type != steamcompmgr_win_type_t::XWAYLAND )
+		return false;
+
+	xwayland_ctx_t *ctx = w->xwayland().ctx;
+	if ( !ctx || window_is_fullscreen( w ) || ctx->force_windows_fullscreen )
+		return false;
+
+	// as large as the X root (= the nested size gamescope hands the app): a fullscreen app without the atom
+	return !( w->GetGeometry().nWidth >= ctx->root_width && w->GetGeometry().nHeight >= ctx->root_height );
