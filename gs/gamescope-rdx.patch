+	// The pointer hint towards one rdx_gs_src: remembers what it was told last and sends only a change
+	// (one HINT packet, under a mutex so the recorded state and the packets stay in order).
+	class CRdxHintSender
+	{
+	public:
+		// pszWho: for the log. A failed send is not recorded, so the next call sends it again.
+		void Set( CRdxBackend *pBackend, bool bRelative, const char *pszWho );
+		// the peer is gone or new: it starts absolute
+		void Reset()
+		{
+			std::lock_guard<std::mutex> lock( m_Mutex );
+			m_bRelative = false;
+			m_bLogged = false;
+		}
+
+	private:
+		std::mutex m_Mutex;
+		bool m_bRelative = false;        // what rdx_gs_src was told last (it starts absolute)
+		bool m_bLogged = false;
+	};
+
+	// What steamcompmgr tells a nested backend's host window, and what it means here: only the
+	// relative mouse mode is of use (the client's pointer), the rest is the host window's business.
+	// Every caller of GetNestedHints() must behave as with nullptr, see ShouldPaintCursor and
+	// SetSelection (steamcompmgr.cpp: cursor texture, hotspot, selection).
+	class CRdxHints final : public INestedHints
+	{
+	public:
+		CRdxHints( CRdxBackend *pBackend ) : m_pBackend( pBackend ) {}
+
+		virtual void SetCursorImage( std::shared_ptr<CursorInfo> info ) override;
+		virtual void SetRelativeMouseMode( bool bRelative ) override;
+		virtual void SetVisible( bool bVisible ) override {}
+		virtual void SetTitle( std::shared_ptr<std::string> szTitle ) override {}
+		virtual void SetIcon( std::shared_ptr<std::vector<uint32_t>> uIconPixels ) override {}
+		virtual void SetSelection( std::shared_ptr<std::string> szContents, GamescopeSelection eSelection ) override
+		{
+			// no host window to hand it to: what a backend without hints does with it
+			gamescope_set_selection( *szContents, eSelection );
+		}
+		// the cursor is part of the frame, unless the client shows it itself (RDX_GS_CURSOR)
+		virtual bool ShouldPaintCursor() override;
+
+	private:
+		CRdxBackend *m_pBackend;
+		CRdxHintSender m_Sender;
+	};
