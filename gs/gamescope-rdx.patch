+// the PipeWire stream, so an HDR monitor still streams SDR. Blit shader, no upscaler pass.
+static void rdx_stream_paint( const struct FrameInfo_t *pMonitorFrame )
+{
+	int nSlot = -1;
+	uint32_t uWidth = 0, uHeight = 0;
+	gamescope::Rc<CVulkanTexture> pTarget = gamescope::RdxStreamBegin( &nSlot, &uWidth, &uHeight );
+	if ( !pTarget || !currentOutputWidth || !currentOutputHeight )
+		return;
+
+	const uint64_t ulBegin = get_time_in_nanos();
+	struct FrameInfo_t frameInfo = *pMonitorFrame;
+	const float flScaleX = (float)uWidth / (float)currentOutputWidth;
+	const float flScaleY = (float)uHeight / (float)currentOutputHeight;
+	for ( int i = 0; i < frameInfo.layers.count(); i++ )
+	{
+		FrameInfo_t::Layer_t &layer = frameInfo.layers.get( i );
