+// rdma-display: a libinput keyboard / pointer of wlroots' session (the DRM backend of a seat's own
+// monitor) exclusively for us: grab the fd the session opened for it (RdxGrabEvdev)
+static void rdx_grab_session_device( struct wlr_input_device *device )
+{
+	if ( !wlserver.wlr.session || !wlr_input_device_is_libinput( device ) || !gamescope::RdxGrabInput() )
+		return;
+	struct libinput_device *pLibInput = wlr_libinput_get_device_handle( device );
+	struct udev_device *pUdev = pLibInput ? libinput_device_get_udev_device( pLibInput ) : nullptr;
+	if ( !pUdev )
+		return;
+	const dev_t devnum = udev_device_get_devnum( pUdev );
+	udev_device_unref( pUdev );
+	struct wlr_device *pDev;
+	wl_list_for_each( pDev, &wlserver.wlr.session->devices, link )
+	{
+		if ( pDev->dev == devnum )
+			gamescope::RdxGrabEvdev( pDev->fd, device->name, false );   // a 2nd capability: EBUSY, own grab
+	}
+}
