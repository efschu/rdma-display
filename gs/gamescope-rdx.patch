+		// tearing mode (rdx_sink_kms --tearing): the client shows frames on arrival, so let
+		// gamescope present as soon as the app does (with --immediate-flips)
+		virtual bool SupportsTearing() const override { return ( m_Hello.flags & RDX_GS_FLAG_TEARING ) != 0; }
+		virtual bool UsesVulkanSwapchain() const override { return false; }
+		virtual bool IsSessionBased() const override { return false; }
+		virtual bool SupportsExplicitSync() const override { return true; }
+		virtual bool IsPaused() const override { return false; }
+		virtual bool IsVisible() const override { return true; }
+		virtual glm::uvec2 CursorSurfaceSize( glm::uvec2 uvecSize ) const override { return uvecSize; }
+		virtual bool HackTemporarySetDynamicRefresh( int nRefresh ) override { return false; }
+		virtual void HackUpdatePatchedEdid() override {}
+
+		// one composite into a free slot; called by the connector's Present
+		int PresentToSlot( const FrameInfo_t *pFrameInfo )
+		{
+			const uint64_t ulEntry = get_time_in_nanos();
+			if ( m_bVrrChange.exchange( false ) )
+				ApplyVrrChange();
+			if ( m_bReconfig.load() )
+			{
+				// this frame was laid out for the old size: drop it, the next one uses the new mode
+				ApplyReconfig();
+				return -EAGAIN;
+			}
+			int nSlot = TakeFreeSlot();
+			if ( nSlot < 0 )
+			{
+				// the client still holds every slot: skip this frame, the next vblank tries again
+				m_ulNoSlot++;
+				return -EAGAIN;
+			}
+
+			// No direct scan-out in this backend: a client's buffer is never handed on as the
+			// frame, every frame is composited into one of our slots (the only memory the NIC
+			// has registered). Log what the layers are whenever their shape changes, and refuse a
+			// layer that would sample one of our own slots.
+			const int nLayers = pFrameInfo->layers.count();
+			uint64_t ulShape = (uint64_t)nLayers;
+			for ( int l = 0; l < nLayers; l++ )
+			{
+				const auto &layer = pFrameInfo->layers.get( l );
+				for ( uint32_t k = 0; k < m_Hello.nslots; k++ )
+					if ( layer.tex != nullptr && layer.tex.get() == m_pSlotTex[ k ].get() )
+					{
+						rdx_log.errorf( "layer %d samples output slot %u: frame dropped", l, k );
+						GiveSlot( nSlot );
+						return -EINVAL;
+					}
+				if ( layer.tex )
+					ulShape = ulShape * 1000003u + ( (uint64_t)layer.tex->width() << 32 | layer.tex->height() ) + layer.tex->format();
+			}
+			if ( ulShape != m_ulLastShape && m_nShapeLogs < 64 )
+			{
+				m_ulLastShape = ulShape;
+				m_nShapeLogs++;
+				char szLayers[ 512 ] = {};
+				size_t o = 0;
+				for ( int l = 0; l < nLayers && o < sizeof( szLayers ) - 48; l++ )
+				{
+					const auto &layer = pFrameInfo->layers.get( l );
+					o += snprintf( szLayers + o, sizeof( szLayers ) - o, " [%d: %ux%u fmt %d z %d]", l,
+					               layer.tex ? layer.tex->width() : 0, layer.tex ? layer.tex->height() : 0,
+					               layer.tex ? (int)layer.tex->format() : -1, (int)layer.zpos );
+				}
+				rdx_log.infof( "frame %llu -> slot %d: %d layers%s", (unsigned long long)m_ulFrames, nSlot, nLayers, szLayers );
+			}
+
+			// vblank-paced: from the vblank wake-up; tearing and variable refresh: from the moment gamescope presents
+			const bool bVrr = m_bVrr.load();
+			const uint64_t ulBegin = ( ( m_Hello.flags & RDX_GS_FLAG_TEARING ) || bVrr ) ? ulEntry : g_SteamCompMgrVBlankTime.ulWakeupTime;
+			std::optional<uint64_t> oSeq = vulkan_composite( (FrameInfo_t *)pFrameInfo, nullptr, false, m_pSlotTex[ nSlot ], false );
+			if ( oSeq && m_HostBuffer[ nSlot ] != VK_NULL_HANDLE )
+			{
+				// host buffer without image import: one GPU copy of the composite into host RAM.
+				// Same queue, so the barrier in it orders the copy after the composite.
+				oSeq = CopyToHost( nSlot );
+			}
+			if ( !oSeq )
+			{
+				GiveSlot( nSlot );
+				return -EIO;
+			}
+			// the NIC reads this memory next, so the frame must be complete in it before READY:
+			// the timeline wait covers the composite (and the copy). Host buffers: the GPU's
+			// writes to system memory are snooped (cache coherent on x86), the HOST_READ barrier
+			// makes them available, and both the CPU and the NIC then see the whole frame.
+			vulkan_wait( *oSeq, true );
+			const uint64_t ulDone = get_time_in_nanos();
+			GetVBlankTimer().UpdateLastDrawTime( ulDone - ulBegin );
+
+			rdx_gs_msg msg = {
+				.magic = RDX_GS_MAGIC, .type = RDX_GS_READY, .slot = (uint32_t)nSlot, .pad = m_uGen,
+				.seq = m_ulFrames++, .t_ns = ulDone, .t_begin_ns = ulBegin,
+			};
+			if ( send( m_nSocket, &msg, sizeof( msg ), MSG_NOSIGNAL ) != (ssize_t)sizeof( msg ) )
+				rdx_log.errorf_errno( "READY to rdx_gs_src failed" );
+			if ( bVrr )
+				MarkVrrFlip( ulDone );
+			return 0;
+		}
+
+		// HINT to rdx_gs_src (any thread: one send() of one packet on the SEQPACKET socket, like READY
+		// and ACK, never blocks the compositor). false: not sent, the caller retries.
+		bool SendHint( uint32_t uBits )
+		{
+			if ( m_nSocket < 0 )
+				return false;
+			rdx_gs_msg msg = { .magic = RDX_GS_MAGIC, .type = RDX_GS_HINT, .slot = uBits, .pad = 0 };
+			return send( m_nSocket, &msg, sizeof( msg ), MSG_NOSIGNAL | MSG_DONTWAIT ) == (ssize_t)sizeof( msg );
+		}
+
+		// variable refresh (RDX_GS_FLAG_VRR), for the connector: any thread
+		bool VrrActive() const { return m_bVrr.load(); }
+
+		// the client shows the cursor itself (RDX_GS_CURSOR 1); never with --force-relative-mouse, which
+		// composites the cursor whatever the backend says (ShouldDrawCursor)
+		bool CursorSeparate() const { return m_bCursorSep.load() && !g_bForceRelativeMouse; }
+
+		// steamcompmgr (getTexture, nested path): the X cursor's picture changed, nullptr = none (empty)
+		void CursorImage( std::shared_ptr<INestedHints::CursorInfo> info )
+		{
+			std::lock_guard<std::mutex> lock( m_CursorMutex );
+			m_pCursorInfo = std::move( info );
+			m_uCursorSerial++;
+			m_bCursorImagePending = m_pCursorInfo != nullptr;
+			m_uCursorImageOff = 0;
+			SendCursorImageLocked();
+		}
+
+		// wlserver lock held (the input thread on every motion, the main loop in RdxCursorTick): where the
+		// hotspot is in output pixels and whether the cursor shows; a CURPOS when that changed
+		void CursorPosition( bool bForce )
+		{
+			if ( m_nSocket < 0 || !CursorSeparate() )
+				return;
+			double flX = 0.0, flY = 0.0;
+			bool bVisible = false;
+			wlserver_cursor_state( &flX, &flY, &bVisible );
+			// surface = ( output + offset ) * scale (touch, the absolute pointer): output = surface / scale - offset
+			const float flScaleX = focusedWindowScaleX > 0.0f ? focusedWindowScaleX : 1.0f;
+			const float flScaleY = focusedWindowScaleY > 0.0f ? focusedWindowScaleY : 1.0f;
+			const int32_t nX = (int32_t)lround( flX / flScaleX - focusedWindowOffsetX );
+			const int32_t nY = (int32_t)lround( flY / flScaleY - focusedWindowOffsetY );
+			std::lock_guard<std::mutex> lock( m_CursorMutex );
+			bVisible = bVisible && m_pCursorInfo != nullptr;
+			if ( !bForce && m_bCursorSent && nX == m_nCursorX && nY == m_nCursorY && bVisible == m_bCursorVisible &&
+			     m_uCursorSentSerial == m_uCursorSerial )
+				return;
+			rdx_gs_msg msg = {
+				.magic = RDX_GS_MAGIC, .type = RDX_GS_CURPOS, .slot = bVisible ? RDX_GS_CUR_VISIBLE : 0u,
+				.pad = m_uCursorSerial, .seq = (uint64_t)(uint32_t)nX | (uint64_t)(uint32_t)nY << 32,
+				.t_ns = get_time_in_nanos(), .t_begin_ns = 0,
+			};
+			if ( send( m_nSocket, &msg, sizeof( msg ), MSG_NOSIGNAL | MSG_DONTWAIT ) != (ssize_t)sizeof( msg ) )
+				return;                  // not recorded: the next motion or tick sends it
+			m_bCursorSent = true;
+			m_nCursorX = nX;
+			m_nCursorY = nY;
+			m_bCursorVisible = bVisible;
+			m_uCursorSentSerial = m_uCursorSerial;
+		}
+
+		// main loop, every pass: a picture that did not fit into the socket yet, and the position after a
+		// relayout or a visibility change that came without a motion
+		void CursorTick()
+		{
+			if ( !CursorSeparate() )
+				return;
+			{
+				std::lock_guard<std::mutex> lock( m_CursorMutex );
+				SendCursorImageLocked();
+			}
+			wlserver_lock();
+			CursorPosition( false );
+			wlserver_unlock( false );
+		}
+
+		// main loop: RDX_GS_CURSOR 1 came, steamcompmgr reads the X cursor again (setDirty), so the whole
+		// state goes to the new client
+		bool CursorTakeResync() { return m_bCursorResync.exchange( false ); }
+
+	protected:
+		virtual void OnBackendBlobDestroyed( BackendBlob *pBlob ) override {}
+
+	private:
+		// the hello's RDX_GS_FLAG_VRR -> m_bVrr (Init, RECONFIG; never in stream mode, where the monitor's
+		// DRM backend owns adaptive sync). gamescope's adaptive_sync convar follows, so GAMESCOPE_VRR_ENABLED
+		// and the frame's allowVRR say the same; a later GAMESCOPE_VRR_ENABLED=0 (Steam's per-game setting)
+		// does not switch it off: the client's screen and its setting decide (logged once, PresentToSlot).
+		void UpdateVrr()
+		{
+			const char *pszEnv = getenv( "RDX_GS_VRR" );
+			const bool bOff = pszEnv && !strcmp( pszEnv, "0" );
+			const bool bWant = ( m_Hello.flags & RDX_GS_FLAG_VRR ) && !( m_Hello.flags & RDX_GS_FLAG_TEARING );
+			const bool bVrr = bWant && !bOff;
+			const bool bWas = m_bVrr.exchange( bVrr );
+			m_ulLastFlip = 0;
+			m_bVrrAppOffLogged = false;
+			if ( bVrr )
+				cv_adaptive_sync = true;
+			else if ( bWas )
+				cv_adaptive_sync = false;
+			if ( bVrr )
+				rdx_log.infof( "variable refresh: on, frames as the app presents them, at most %.3f Hz (no vblank pacing)",
+				               m_Hello.refresh_mhz / 1000.0 );
+			else if ( bWant )
+				rdx_log.infof( "variable refresh: off (RDX_GS_VRR=0), fixed %.3f Hz on our vblank timer", m_Hello.refresh_mhz / 1000.0 );
+			else if ( bWas )
+				rdx_log.infof( "variable refresh: off, the client's vblank paces us again (%.3f Hz)", m_Hello.refresh_mhz / 1000.0 );
+		}
+
+		// paint thread: RDX_GS_VRR from rdx_gs_src (the client's screen changed variable refresh during the
+		// session, or a resume at the same mode): the new refresh (the cap, or the sink's fixed refresh) and
+		// adaptive sync, like ApplyReconfig without new buffers
+		void ApplyVrrChange()
+		{
+			std::lock_guard<std::mutex> lock( m_ReconfigMutex );
+			const uint32_t uOld = m_Hello.refresh_mhz;
+			if ( m_uPendingVrrMhz.load() >= 1000 )
+				m_Hello.refresh_mhz = m_uPendingVrrMhz.load();
+			m_Hello.flags = m_bPendingVrrOn.load() ? ( m_Hello.flags | RDX_GS_FLAG_VRR ) : ( m_Hello.flags & ~RDX_GS_FLAG_VRR );
+			g_nOutputRefresh = m_Hello.refresh_mhz;
+			g_nNestedRefresh = m_Hello.refresh_mhz;
+			rdx_log.infof( "RDX_GS_VRR: %.3f Hz -> %.3f Hz", uOld / 1000.0, m_Hello.refresh_mhz / 1000.0 );
+			UpdateVrr();
+			force_repaint();
+		}
+
+		// paint thread, variable refresh: the frame composited at ulDone flips now, or one cap period after
+		// the previous flip if it came sooner (rdx_gs_src holds the post until then, the same rule as
+		// rdx_gs_vrr_hold_until: within 2 % of the period it goes now). That moment is our vblank, like the
+		// DRM backend's page flip event: steamcompmgr's flip-ready test and frame limiter measure from it.
+		void MarkVrrFlip( uint64_t ulDone )
+		{
+			const uint64_t ulPeriod = gamescope::mHzToRefreshCycle( (int32_t)m_Hello.refresh_mhz );
+			uint64_t ulFlip = ulDone;
+			if ( m_ulLastFlip && ulDone + ulPeriod / 50 < m_ulLastFlip + ulPeriod )
+				ulFlip = m_ulLastFlip + ulPeriod;
+			m_ulLastFlip = ulFlip;
+			GetVBlankTimer().MarkVBlank( ulFlip, true );
+			if ( !cv_adaptive_sync && !m_bVrrAppOffLogged )
+			{
+				m_bVrrAppOffLogged = true;
+				rdx_log.infof( "GAMESCOPE_VRR_ENABLED=0 (Steam's per-game setting?) ignored: the client's screen runs "
+				               "variable refresh and its setting decides (RDX_GS_VRR=0 turns it off here)" );
+			}
+		}
+
+		// connect to rdx_gs_src and take its hello + buffer fds; bQuiet: a stream polling for a
+		// listener (no error lines while nobody listens)
+		bool Connect( const char *pszPath, bool bQuiet )
+		{
+			m_nSocket = socket( AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0 );
+			sockaddr_un addr = { .sun_family = AF_UNIX };
+			snprintf( addr.sun_path, sizeof( addr.sun_path ), "%s", pszPath );
+			if ( m_nSocket < 0 || connect( m_nSocket, (sockaddr *)&addr, sizeof( addr ) ) != 0 )
+			{
+				if ( !bQuiet )
+					rdx_log.errorf_errno( "connect %s", pszPath );
+				if ( m_nSocket >= 0 )
+					close( m_nSocket );
+				m_nSocket = -1;
+				return false;
+			}
+
+			iovec iov = { .iov_base = &m_Hello, .iov_len = sizeof( m_Hello ) };
+			alignas( cmsghdr ) char cbuf[ CMSG_SPACE( sizeof( int ) * RDX_GS_MAX_SLOTS ) ];
+			msghdr m = { .msg_iov = &iov, .msg_iovlen = 1, .msg_control = cbuf, .msg_controllen = sizeof( cbuf ) };
+			if ( recvmsg( m_nSocket, &m, MSG_CMSG_CLOEXEC ) != (ssize_t)sizeof( m_Hello ) ||
+			     m_Hello.magic != RDX_GS_MAGIC || m_Hello.type != RDX_GS_HELLO ||
+			     m_Hello.nslots == 0 || m_Hello.nslots > RDX_GS_MAX_SLOTS ||
+			     ( m_Hello.buf_kind != RDX_GS_BUF_VRAM && m_Hello.buf_kind != RDX_GS_BUF_HOST ) )
+			{
+				rdx_log.errorf( "invalid hello from rdx_gs_src (protocol mismatch?)" );
+				return false;
+			}
+			cmsghdr *c = CMSG_FIRSTHDR( &m );
+			if ( !c || c->cmsg_type != SCM_RIGHTS || c->cmsg_len != CMSG_LEN( sizeof( int ) * m_Hello.nslots ) )
+			{
+				rdx_log.errorf( "hello without %u buffer fds", m_Hello.nslots );
+				return false;
+			}
+			memcpy( m_nSlotFds, CMSG_DATA( c ), sizeof( int ) * m_Hello.nslots );
+			rdx_log.infof( "client mode %ux%u @ %.3f Hz, %u %s slots of %llu B, stride %u%s", m_Hello.width, m_Hello.height,
+			               m_Hello.refresh_mhz / 1000.0, m_Hello.nslots, m_Hello.buf_kind == RDX_GS_BUF_HOST ? "host" : "VRAM",
+			               (unsigned long long)m_Hello.slot_size, m_Hello.stride,
+			               ( m_Hello.flags & RDX_GS_FLAG_TEARING ) ? ", tearing (no vblank pacing)"
+			               : ( m_Hello.flags & RDX_GS_FLAG_VRR ) ? ", variable refresh (the refresh is the cap)" : "" );
+			return true;
+		}
+
+		// the picture as CURIMG chunks (m_CursorMutex held); a full socket leaves it pending and RdxCursorTick goes
+		// on from that chunk (a 256x256 picture is 16 chunks of 16 KiB, more than a unix socket holds unread)
+		void SendCursorImageLocked()
+		{
+			if ( !m_bCursorImagePending || m_nSocket < 0 || !CursorSeparate() || !m_pCursorInfo )
+				return;
+			const INestedHints::CursorInfo &info = *m_pCursorInfo;
+			const uint32_t uW = std::min<uint32_t>( info.uWidth, RDX_GS_CUR_MAX );
+			const uint32_t uH = std::min<uint32_t>( info.uHeight, RDX_GS_CUR_MAX );
+			if ( !uW || !uH || info.pPixels.size() < (size_t)info.uWidth * info.uHeight )
+			{
+				m_bCursorImagePending = false;
+				return;
+			}
+			std::vector<uint32_t> vecPixels( (size_t)uW * uH );     // rows of uW: a bigger picture is clipped
+			for ( uint32_t y = 0; y < uH; y++ )
+				memcpy( &vecPixels[ (size_t)y * uW ], &info.pPixels[ (size_t)y * info.uWidth ], uW * 4 );
+			const uint32_t uTotal = uW * uH * 4;
+			std::vector<uint8_t> vecPacket( sizeof( rdx_gs_curimg ) + RDX_GS_CUR_CHUNK );
+			const uint64_t ulNow = get_time_in_nanos();
+			for ( uint32_t uOff = m_uCursorImageOff; uOff < uTotal; uOff += RDX_GS_CUR_CHUNK )
+			{
+				const uint32_t uLen = std::min<uint32_t>( RDX_GS_CUR_CHUNK, uTotal - uOff );
+				rdx_gs_curimg hdr = {
+					.magic = RDX_GS_MAGIC, .type = RDX_GS_CURIMG, .serial = m_uCursorSerial,
+					.w = (uint16_t)uW, .h = (uint16_t)uH,
+					.hot_x = (uint16_t)std::min<uint32_t>( info.uXHotspot, uW - 1 ),
+					.hot_y = (uint16_t)std::min<uint32_t>( info.uYHotspot, uH - 1 ),
+					.off = uOff, .len = uLen, .pad = 0, .t_ns = ulNow,
+				};
+				memcpy( vecPacket.data(), &hdr, sizeof( hdr ) );
+				memcpy( vecPacket.data() + sizeof( hdr ), (const uint8_t *)vecPixels.data() + uOff, uLen );
+				const size_t uSize = sizeof( hdr ) + uLen;
+				if ( send( m_nSocket, vecPacket.data(), uSize, MSG_NOSIGNAL | MSG_DONTWAIT ) != (ssize_t)uSize )
+					return;              // pending: on from this chunk
+				m_uCursorImageOff = uOff + uLen;
+			}
+			m_bCursorImagePending = false;
+			m_uCursorImageOff = 0;
+			if ( !m_bCursorLogged )
+			{
+				m_bCursorLogged = true;
+				rdx_log.infof( "cursor next to the picture: first picture %ux%u (hotspot %u,%u) sent", uW, uH,
+				               info.uXHotspot, info.uYHotspot );
+			}
+		}
+
+		// RDX_GS_CURSOR from rdx_gs_src (receive thread)
+		void SetCursorSeparate( bool bOn )
+		{
+			const bool bWas = m_bCursorSep.exchange( bOn );
+			{
+				std::lock_guard<std::mutex> lock( m_CursorMutex );
+				m_bCursorSent = false;                 // a new client: the whole state again
+				m_bCursorImagePending = m_pCursorInfo != nullptr;
+				m_uCursorImageOff = 0;
+			}
+			if ( bOn )
+				m_bCursorResync = true;
+			if ( bWas != bOn )
+				rdx_log.infof( "cursor: %s", bOn ? "next to the picture, the client shows it (none drawn into the frames)"
+				                                 : "drawn into the frames" );
+			force_repaint();                           // the frame with or without it
+		}
+
+		void SendAck( uint32_t uRowPitch, int nError, uint32_t uPath = 0 )
+		{
+			rdx_gs_ack ack = { .magic = RDX_GS_MAGIC, .type = RDX_GS_ACK, .row_pitch = uRowPitch, .error = nError,
+			                   .path = uPath, .pad = 0 };
+			send( m_nSocket, &ack, sizeof( ack ), MSG_NOSIGNAL );
+		}
+
+		uint32_t FindType( uint32_t uBits, VkMemoryPropertyFlags want )
+		{
+			VkPhysicalDeviceMemoryProperties memProps;
+			g_device.vk.GetPhysicalDeviceMemoryProperties( g_device.physDev(), &memProps );
+			for ( uint32_t t = 0; t < memProps.memoryTypeCount; t++ )
+				if ( ( uBits & ( 1u << t ) ) && ( memProps.memoryTypes[ t ].propertyFlags & want ) == want )
+					return t;
+			return UINT32_MAX;
+		}
+
+		bool ImportSlots()
+		{
+			return m_Hello.buf_kind == RDX_GS_BUF_HOST ? ImportHostSlots() : ImportVramSlots();
+		}
+
+		// one linear B8G8R8A8 image for slot i (memory bound by the caller); mutable, because the
+		// texture wrapper creates a UNORM storage view and an sRGB sampled view
+		bool CreateLinearImage( uint32_t i, const void *pExtInfo, VkMemoryRequirements *pReq )
+		{
+			const VkFormat formats[] = { VK_FORMAT_B8G8R8A8_UNORM, VK_FORMAT_B8G8R8A8_SRGB };
+			VkImageFormatListCreateInfo formatList = {
+				.sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO, .pNext = pExtInfo,
+				.viewFormatCount = 2, .pViewFormats = formats,
+			};
+			VkImageCreateInfo imageInfo = {
+				.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .pNext = &formatList,
+				.flags = VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT | VK_IMAGE_CREATE_EXTENDED_USAGE_BIT,
+				.imageType = VK_IMAGE_TYPE_2D, .format = VK_FORMAT_B8G8R8A8_UNORM,
+				.extent = { m_Hello.width, m_Hello.height, 1 }, .mipLevels = 1, .arrayLayers = 1,
+				.samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_LINEAR,
+				.usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+				         VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+				.sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+				.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+			};
+			VkResult res = g_device.vk.CreateImage( g_device.device(), &imageInfo, nullptr, &m_Images[ i ] );
+			if ( res != VK_SUCCESS )
+			{
+				rdx_log.errorf( "vkCreateImage (linear, external memory) failed: %d", res );
+				SendAck( 0, -EINVAL );
+				return false;
+			}
+			g_device.vk.GetImageMemoryRequirements( g_device.device(), m_Images[ i ], pReq );
+			if ( pReq->size > m_Hello.slot_size )
+			{
+				rdx_log.errorf( "image needs %llu B, slot has %llu B", (unsigned long long)pReq->size, (unsigned long long)m_Hello.slot_size );
+				SendAck( 0, -ENOSPC );
+				return false;
+			}
+			return true;
+		}
+
+		// bound image -> row pitch check -> output texture
+		bool WrapSlotImage( uint32_t i )
+		{
+			VkImageSubresource sub = { .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT };
+			VkSubresourceLayout layout;
+			g_device.vk.GetImageSubresourceLayout( g_device.device(), m_Images[ i ], &sub, &layout );
+			if ( layout.offset != 0 || ( m_uRowPitch && layout.rowPitch != m_uRowPitch ) )
+			{
+				rdx_log.errorf( "slot %u: offset %llu, row pitch %llu", i, (unsigned long long)layout.offset, (unsigned long long)layout.rowPitch );
+				SendAck( (uint32_t)layout.rowPitch, -EINVAL );
+				return false;
+			}
+			m_uRowPitch = (uint32_t)layout.rowPitch;
+			m_pSlotTex[ i ] = new CVulkanTexture();
+			if ( !m_pSlotTex[ i ]->BInitFromSwapchain( m_Images[ i ], m_Hello.width, m_Hello.height, VK_FORMAT_B8G8R8A8_UNORM ) )
+			{
+				SendAck( m_uRowPitch, -EIO );
+				return false;
+			}
+			return true;
+		}
+
+		// opaque fd -> linear image bound to the imported VRAM -> output texture
+		bool ImportVramSlots()
+		{
+			for ( uint32_t i = 0; i < m_Hello.nslots; i++ )
+			{
+				VkExternalMemoryImageCreateInfo extInfo = {
+					.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO,
+					.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT,
+				};
+				VkMemoryRequirements req;
+				if ( !CreateLinearImage( i, &extInfo, &req ) )
+					return false;
+				uint32_t uType = FindType( req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT );
+				VkImportMemoryFdInfoKHR importInfo = {
+					.sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+					.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT,
+					.fd = m_nSlotFds[ i ],          // owned by Vulkan once the import succeeds
+				};
+				VkMemoryAllocateInfo allocInfo = {
+					.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, .pNext = &importInfo,
+					.allocationSize = m_Hello.slot_size, .memoryTypeIndex = uType,
+				};
+				VkResult res = g_device.vk.AllocateMemory( g_device.device(), &allocInfo, nullptr, &m_Memory[ i ] );
+				if ( res == VK_SUCCESS )
+					res = g_device.vk.BindImageMemory( g_device.device(), m_Images[ i ], m_Memory[ i ], 0 );
+				if ( res != VK_SUCCESS )
+				{
+					rdx_log.errorf( "import of slot %u failed: %d", i, res );
+					SendAck( 0, -EIO );
+					return false;
+				}
+				if ( !WrapSlotImage( i ) )
+					return false;
+			}
+			rdx_log.infof( "imported %u VRAM slots, row pitch %u", m_Hello.nslots, m_uRowPitch );
+			SendAck( m_uRowPitch, m_uRowPitch == m_Hello.stride ? 0 : -EINVAL );
+			return m_uRowPitch == m_Hello.stride;
+		}
+
+		// can the driver import a host pointer as a linear image we can composite into?
+		bool HostImageImportable()
+		{
+			VkPhysicalDeviceExternalImageFormatInfo extInfo = {
+				.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO,
+				.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+			};
+			VkPhysicalDeviceImageFormatInfo2 info = {
+				.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2, .pNext = &extInfo,
+				.format = VK_FORMAT_B8G8R8A8_UNORM, .type = VK_IMAGE_TYPE_2D, .tiling = VK_IMAGE_TILING_LINEAR,
+				.usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+				         VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+				.flags = VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT | VK_IMAGE_CREATE_EXTENDED_USAGE_BIT,
+			};
+			VkExternalImageFormatProperties extProps = { .sType = VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES };
+			VkImageFormatProperties2 props = { .sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2, .pNext = &extProps };
+			if ( g_device.vk.GetPhysicalDeviceImageFormatProperties2( g_device.physDev(), &info, &props ) != VK_SUCCESS )
+				return false;
+			return ( extProps.externalMemoryProperties.externalMemoryFeatures & VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT ) != 0;
+		}
+
+		// memfd -> mapping -> VK_EXT_external_memory_host import, as a buffer (composite into a
+		// VRAM image, then one copy into it; the default) or as a linear image (composite straight
+		// into host RAM; RDX_GS_HOST_DIRECT=1). Measured on the 2080 Ti behind the chipset, 1080p:
+		// present -> done 3.2 ms with the copy, 6.9 ms straight (the composite shader writes to
+		// host RAM much slower than the copy engine streams).
+		// Host slots handed over as dma-bufs (udmabuf of the memfd slots, the same pages the NIC
+		// reads): amdgpu imports a host pointer of anonymous memory only, not of a shared memfd
+		// mapping, so RADV takes the host buffers this way. Copy path only: composite into a VRAM
+		// image, one GPU copy into the imported buffer (CopyToHost), exactly as with a host pointer.
+		bool ImportDmabufSlots()
+		{
+			auto pfnFdProps = (PFN_vkGetMemoryFdPropertiesKHR)
+				g_device.vk.GetDeviceProcAddr( g_device.device(), "vkGetMemoryFdPropertiesKHR" );
+			m_pfnCopyImageToBuffer = (PFN_vkCmdCopyImageToBuffer)
+				g_device.vk.GetDeviceProcAddr( g_device.device(), "vkCmdCopyImageToBuffer" );
+			if ( !pfnFdProps || !m_pfnCopyImageToBuffer )
+			{
+				rdx_log.errorf( "VK_EXT_external_memory_dma_buf is not available on this device" );
+				SendAck( 0, -ENOTSUP, 1 );
+				return false;
+			}
+			rdx_log.infof( "host buffers as dma-bufs: composite into VRAM + one GPU copy into them" );
+			for ( uint32_t i = 0; i < m_Hello.nslots; i++ )
+			{
+				VkExternalMemoryBufferCreateInfo extInfo = {
+					.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO,
+					.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+				};
+				VkBufferCreateInfo bufInfo = {
+					.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, .pNext = &extInfo,
+					.size = m_Hello.slot_size, .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+					.sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+				};
+				VkResult res = g_device.vk.CreateBuffer( g_device.device(), &bufInfo, nullptr, &m_HostBuffer[ i ] );
+				VkMemoryRequirements req = {};
+				if ( res == VK_SUCCESS )
+					g_device.vk.GetBufferMemoryRequirements( g_device.device(), m_HostBuffer[ i ], &req );
+				VkMemoryFdPropertiesKHR fdProps = { .sType = VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR };
+				if ( res == VK_SUCCESS )
+					res = pfnFdProps( g_device.device(), VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT, m_nSlotFds[ i ], &fdProps );
+				uint32_t uType = res == VK_SUCCESS ? FindType( req.memoryTypeBits & fdProps.memoryTypeBits, 0 ) : UINT32_MAX;
+				VkImportMemoryFdInfoKHR importInfo = {
+					.sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+					.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+					.fd = m_nSlotFds[ i ],          // owned by Vulkan once the import succeeds
+				};
+				VkMemoryAllocateInfo allocInfo = {
+					.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, .pNext = &importInfo,
+					.allocationSize = m_Hello.slot_size, .memoryTypeIndex = uType,
+				};
+				if ( res == VK_SUCCESS )
+					res = uType == UINT32_MAX ? VK_ERROR_FORMAT_NOT_SUPPORTED
+					                          : g_device.vk.AllocateMemory( g_device.device(), &allocInfo, nullptr, &m_Memory[ i ] );
+				if ( res == VK_SUCCESS )
+				{
+					m_nSlotFds[ i ] = -1;
+					res = g_device.vk.BindBufferMemory( g_device.device(), m_HostBuffer[ i ], m_Memory[ i ], 0 );
+				}
+				if ( res != VK_SUCCESS )
+				{
+					rdx_log.errorf( "import of dma-buf slot %u failed: %d (memory types 0x%x & 0x%x)", i, res,
+					                req.memoryTypeBits, fdProps.memoryTypeBits );
+					SendAck( 0, -EIO, 1 );
+					return false;
+				}
+				CVulkanTexture::createFlags flags;
+				flags.bStorage = true;
+				flags.bSampled = true;
+				flags.bTransferSrc = true;
+				flags.bOutputImage = true;
+				m_pSlotTex[ i ] = new CVulkanTexture();
+				if ( !m_pSlotTex[ i ]->BInit( m_Hello.width, m_Hello.height, 1u, VulkanFormatToDRM( VK_FORMAT_B8G8R8A8_UNORM ), flags ) )
+				{
+					rdx_log.errorf( "VRAM composite image for slot %u failed", i );
+					SendAck( 0, -ENOMEM, 1 );
+					return false;
+				}
+			}
+			rdx_log.infof( "imported %u dma-buf host slots, row pitch %u", m_Hello.nslots, m_Hello.stride );
+			SendAck( m_Hello.stride, 0, 1 );
+			return true;
+		}
+
+		bool ImportHostSlots()
+		{
+			if ( m_Hello.flags & RDX_GS_FLAG_DMABUF )
+				return ImportDmabufSlots();
+			auto pfnHostProps = (PFN_vkGetMemoryHostPointerPropertiesEXT)
+				g_device.vk.GetDeviceProcAddr( g_device.device(), "vkGetMemoryHostPointerPropertiesEXT" );
+			m_pfnCopyImageToBuffer = (PFN_vkCmdCopyImageToBuffer)
+				g_device.vk.GetDeviceProcAddr( g_device.device(), "vkCmdCopyImageToBuffer" );
+			if ( !pfnHostProps || !m_pfnCopyImageToBuffer )
+			{
+				rdx_log.errorf( "VK_EXT_external_memory_host is not available on this device" );
+				SendAck( 0, -ENOTSUP );
+				return false;
+			}
+			VkPhysicalDeviceExternalMemoryHostPropertiesEXT hostProps = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_MEMORY_HOST_PROPERTIES_EXT };
+			VkPhysicalDeviceProperties2 props2 = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, .pNext = &hostProps };
+			g_device.vk.GetPhysicalDeviceProperties2( g_device.physDev(), &props2 );
+			const VkDeviceSize ulAlign = hostProps.minImportedHostPointerAlignment;
+			if ( ulAlign == 0 || m_Hello.slot_size % ulAlign != 0 )
+			{
+				rdx_log.errorf( "slot size %llu is not a multiple of the host pointer alignment %llu",
+				                (unsigned long long)m_Hello.slot_size, (unsigned long long)ulAlign );
+				SendAck( 0, -EINVAL );
+				return false;
+			}
+			const char *pszDirect = getenv( "RDX_GS_HOST_DIRECT" );
+			const bool bDirect = pszDirect && pszDirect[ 0 ] == '1' && HostImageImportable();
+			const uint32_t uPath = bDirect ? 0 : 1;
+			rdx_log.infof( "host buffers: %s (host pointer alignment %llu)",
+			               bDirect ? "composite straight into them (linear image on a host pointer)"
+			                       : "composite into VRAM + one GPU copy into them",
+			               (unsigned long long)ulAlign );
+
+			for ( uint32_t i = 0; i < m_Hello.nslots; i++ )
+			{
+				void *p = mmap( nullptr, m_Hello.slot_size, PROT_READ | PROT_WRITE, MAP_SHARED, m_nSlotFds[ i ], 0 );
+				close( m_nSlotFds[ i ] );
+				m_nSlotFds[ i ] = -1;
+				if ( p == MAP_FAILED )
+				{
+					rdx_log.errorf_errno( "mmap of host slot %u", i );
+					SendAck( 0, -ENOMEM, uPath );
+					return false;
+				}
+				m_pHostMap[ i ] = p;
+				VkMemoryHostPointerPropertiesEXT ptrProps = { .sType = VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT };
+				VkResult res = pfnHostProps( g_device.device(), VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT, p, &ptrProps );
+				if ( res != VK_SUCCESS )
+				{
+					rdx_log.errorf( "vkGetMemoryHostPointerPropertiesEXT on slot %u: %d", i, res );
+					SendAck( 0, -EIO, uPath );
+					return false;
+				}
+				VkMemoryRequirements req;
+				if ( bDirect )
+				{
+					VkExternalMemoryImageCreateInfo extInfo = {
+						.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO,
+						.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+					};
+					if ( !CreateLinearImage( i, &extInfo, &req ) )
+						return false;
+				}
+				else
+				{
+					VkExternalMemoryBufferCreateInfo extInfo = {
+						.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO,
+						.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+					};
+					VkBufferCreateInfo bufInfo = {
+						.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, .pNext = &extInfo,
+						.size = m_Hello.slot_size, .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+						.sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+					};
+					res = g_device.vk.CreateBuffer( g_device.device(), &bufInfo, nullptr, &m_HostBuffer[ i ] );
+					if ( res != VK_SUCCESS )
+					{
+						rdx_log.errorf( "vkCreateBuffer on a host pointer: %d", res );
+						SendAck( 0, -EINVAL, uPath );
+						return false;
+					}
+					g_device.vk.GetBufferMemoryRequirements( g_device.device(), m_HostBuffer[ i ], &req );
+				}
+				uint32_t uType = FindType( req.memoryTypeBits & ptrProps.memoryTypeBits, 0 );
+				VkImportMemoryHostPointerInfoEXT importInfo = {
+					.sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT,
+					.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+					.pHostPointer = p,
+				};
+				VkMemoryAllocateInfo allocInfo = {
+					.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, .pNext = &importInfo,
+					.allocationSize = m_Hello.slot_size, .memoryTypeIndex = uType,
+				};
+				res = uType == UINT32_MAX ? VK_ERROR_FORMAT_NOT_SUPPORTED
+				                          : g_device.vk.AllocateMemory( g_device.device(), &allocInfo, nullptr, &m_Memory[ i ] );
+				if ( res == VK_SUCCESS )
+					res = bDirect ? g_device.vk.BindImageMemory( g_device.device(), m_Images[ i ], m_Memory[ i ], 0 )
+					              : g_device.vk.BindBufferMemory( g_device.device(), m_HostBuffer[ i ], m_Memory[ i ], 0 );
+				if ( res != VK_SUCCESS )
+				{
+					rdx_log.errorf( "import of host slot %u failed: %d (memory types 0x%x & 0x%x)", i, res,
+					                req.memoryTypeBits, ptrProps.memoryTypeBits );
+					SendAck( 0, -EIO, uPath );
+					return false;
+				}
+				if ( bDirect )
+				{
+					if ( !WrapSlotImage( i ) )
+						return false;
+					continue;
+				}
+				// the composite target of the copy path: an ordinary output image in VRAM
+				CVulkanTexture::createFlags flags;
+				flags.bStorage = true;
+				flags.bSampled = true;
+				flags.bTransferSrc = true;
+				flags.bOutputImage = true;
+				m_pSlotTex[ i ] = new CVulkanTexture();
+				if ( !m_pSlotTex[ i ]->BInit( m_Hello.width, m_Hello.height, 1u, VulkanFormatToDRM( VK_FORMAT_B8G8R8A8_UNORM ), flags ) )
+				{
+					rdx_log.errorf( "VRAM composite image for slot %u failed", i );
+					SendAck( 0, -ENOMEM, uPath );
+					return false;
+				}
+			}
+			// the copy writes rows at the sink stride (bufferRowLength), so it always matches
+			const uint32_t uPitch = bDirect ? m_uRowPitch : m_Hello.stride;
+			rdx_log.infof( "imported %u host slots, row pitch %u", m_Hello.nslots, uPitch );
+			SendAck( uPitch, uPitch == m_Hello.stride ? 0 : -EINVAL, uPath );
+			return uPitch == m_Hello.stride;
+		}
+
+		// composite image (VRAM, GENERAL layout after the composite) -> host buffer at the sink stride
+		std::optional<uint64_t> CopyToHost( int nSlot )
+		{
+			auto cmd = g_device.commandBuffer();
+			VkCommandBuffer cb = cmd->rawBuffer();
+			VkMemoryBarrier before = {
+				.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+				.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT, .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+			};
+			g_device.vk.CmdPipelineBarrier( cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+			                                1, &before, 0, nullptr, 0, nullptr );
+			VkBufferImageCopy region = {
+				.bufferOffset = 0, .bufferRowLength = m_Hello.stride / 4, .bufferImageHeight = 0,
+				.imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+				.imageOffset = { 0, 0, 0 }, .imageExtent = { m_Hello.width, m_Hello.height, 1 },
+			};
+			m_pfnCopyImageToBuffer( cb, m_pSlotTex[ nSlot ]->vkImage(), VK_IMAGE_LAYOUT_GENERAL, m_HostBuffer[ nSlot ], 1, &region );
+			VkMemoryBarrier after = {
+				.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+				.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT, .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+			};
+			g_device.vk.CmdPipelineBarrier( cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0,
+			                                1, &after, 0, nullptr, 0, nullptr );
+			return g_device.submit( std::move( cmd ) );
+		}
+
+		// all GPU work done, then the slot images, memory, buffers and mappings go
+		void ReleaseSlots()
+		{
+			g_device.waitIdle();        // waits for every submission and releases their texture refs
+			g_device.garbageCollect();
+			for ( uint32_t i = 0; i < RDX_GS_MAX_SLOTS; i++ )
+			{
+				m_pSlotTex[ i ] = nullptr;
+				if ( m_Images[ i ] )
+					g_device.vk.DestroyImage( g_device.device(), m_Images[ i ], nullptr );
+				if ( m_HostBuffer[ i ] )
+					g_device.vk.DestroyBuffer( g_device.device(), m_HostBuffer[ i ], nullptr );
+				if ( m_Memory[ i ] )
+					g_device.vk.FreeMemory( g_device.device(), m_Memory[ i ], nullptr );
+				if ( m_pHostMap[ i ] )
+					munmap( m_pHostMap[ i ], m_Hello.slot_size );
+				m_Images[ i ] = VK_NULL_HANDLE;
+				m_HostBuffer[ i ] = VK_NULL_HANDLE;
+				m_Memory[ i ] = VK_NULL_HANDLE;
+				m_pHostMap[ i ] = nullptr;
+			}
+		}
+
+		// paint thread: new client mode and buffers from RECONFIG
+		void ApplyReconfig()
+		{
+			std::lock_guard<std::mutex> lock( m_ReconfigMutex );
+			m_bReconfig = false;
+			const uint32_t uOldW = m_Hello.width, uOldH = m_Hello.height, uOldR = m_Hello.refresh_mhz;
+			ReleaseSlots();
+			m_Hello = m_PendingHello;
+			memcpy( m_nSlotFds, m_nPendingFds, sizeof( int ) * m_Hello.nslots );
+			m_uRowPitch = 0;
+			m_uFreeMask = 0;
+			m_uLastSlot = m_Hello.nslots - 1;
+			m_uGen++;
+			if ( !ImportSlots() )      // sends the ACK; on failure rdx_gs_src ends the session
+				return;
+			if ( m_bStream )           // the monitor keeps its mode, only the stream's size changes
+			{
+				rdx_log.infof( "stream RECONFIG (generation %u): %ux%u -> %ux%u", m_uGen, uOldW, uOldH,
+				               m_Hello.width, m_Hello.height );
+				UpdateStreamVrr( ( m_Hello.flags & RDX_GS_FLAG_VRR ) != 0, "RECONFIG" );
+				return;
+			}
+			g_nOutputWidth = m_Hello.width;
+			g_nOutputHeight = m_Hello.height;
+			g_nOutputRefresh = m_Hello.refresh_mhz;
+			g_nNestedRefresh = m_Hello.refresh_mhz;
+			UpdateVrr();
+			rdx_log.infof( "RECONFIG (generation %u): %ux%u @ %.3f Hz -> %ux%u @ %.3f Hz, %u slots", m_uGen,
+			               uOldW, uOldH, uOldR / 1000.0, m_Hello.width, m_Hello.height, m_Hello.refresh_mhz / 1000.0,
+			               m_Hello.nslots );
+			force_repaint();
+		}
+
+		void RecvThread()
+		{
+			pthread_setname_np( pthread_self(), "gamescope-rdx" );
+			RecvLoop();
+			if ( m_bRunning )
+			{
+				rdx_log.infof( "rdx_gs_src ended the session (%llu frames, %llu without a free slot)",
+				               (unsigned long long)m_ulFrames, (unsigned long long)m_ulNoSlot );
+				raise( SIGTERM );
+			}
+		}
+
+		// messages from rdx_gs_src until it ends the session (BYE, socket closed)
+		void RecvLoop()
+		{
+			while ( m_bRunning )
+			{
+				union { rdx_gs_msg msg; rdx_gs_hello hello; } u;
+				alignas( cmsghdr ) char cbuf[ CMSG_SPACE( sizeof( int ) * RDX_GS_MAX_SLOTS ) ];
+				iovec iov = { .iov_base = &u, .iov_len = sizeof( u ) };
+				msghdr mh = { .msg_iov = &iov, .msg_iovlen = 1, .msg_control = cbuf, .msg_controllen = sizeof( cbuf ) };
+				ssize_t n = recvmsg( m_nSocket, &mh, MSG_CMSG_CLOEXEC );
+				if ( n <= 0 )
+					break;
+				if ( n == (ssize_t)sizeof( rdx_gs_hello ) && u.hello.magic == RDX_GS_MAGIC && u.hello.type == RDX_GS_RECONFIG )
+				{
+					cmsghdr *c = CMSG_FIRSTHDR( &mh );
+					if ( u.hello.nslots == 0 || u.hello.nslots > RDX_GS_MAX_SLOTS || u.hello.buf_kind != m_Hello.buf_kind ||
+					     !c || c->cmsg_type != SCM_RIGHTS || c->cmsg_len != CMSG_LEN( sizeof( int ) * u.hello.nslots ) )
+					{
+						rdx_log.errorf( "invalid RECONFIG from rdx_gs_src" );
+						SendAck( 0, -EINVAL );
+						continue;
+					}
+					std::lock_guard<std::mutex> lock( m_ReconfigMutex );
+					m_PendingHello = u.hello;
+					memcpy( m_nPendingFds, CMSG_DATA( c ), sizeof( int ) * u.hello.nslots );
+					m_bReconfig = true;
+					force_repaint();        // the paint thread applies it
+					continue;
+				}
+				rdx_gs_msg &msg = u.msg;
+				if ( n != (ssize_t)sizeof( msg ) || msg.magic != RDX_GS_MAGIC )
+					continue;
+				if ( msg.type == RDX_GS_FREE && msg.slot < m_Hello.nslots )
+					GiveSlot( (int)msg.slot );
+				else if ( msg.type == RDX_GS_VBLANK && ( m_bStream ? RdxClientLeads() : !m_bVrr.load() ) )
+					GetVBlankTimer().MarkVBlank( msg.t_ns, true );
+				else if ( msg.type == RDX_GS_VRR && m_bStream )
+					UpdateStreamVrr( msg.slot != 0, "RDX_GS_VRR" );     // the client's screen changed
+				else if ( msg.type == RDX_GS_VRR && !m_bStream )
+				{
+					// variable refresh on / off with the same buffers: the paint thread applies it
+					m_uPendingVrrMhz = (uint32_t)msg.t_ns;
+					m_bPendingVrrOn = msg.slot != 0;
+					m_bVrrChange = true;
+					force_repaint();
+				}
+				else if ( msg.type == RDX_GS_CURSOR && !m_bStream )
+					SetCursorSeparate( msg.slot != 0 );
+				else if ( msg.type == RDX_GS_INPUT && !m_bStream )
+				{
+					// the stream detached (the app waits in the background, maybe next to another app's
+					// gamescope in the stream) or attached again: the input thread lets go / reads again
+					m_bInputWanted = msg.slot != 0;
+					if ( m_nInputWake[ 1 ] >= 0 && write( m_nInputWake[ 1 ], "x", 1 ) != 1 && errno != EAGAIN )
+						rdx_log.errorf_errno( "waking the input thread" );
+				}
+				else if ( msg.type == RDX_GS_BYE )
+					break;
+			}
+		}
+
+	public:
+		/////////////////////////////////////////////////////////////////
+		// stream mode (add-on output next to another backend)
+		/////////////////////////////////////////////////////////////////
+
+		void StartStream( const char *pszPath )
+		{
+			m_strStreamPath = pszPath;
+			m_StreamThread = std::thread( [this]() { StreamThread(); } );
+			rdx_log.infof( "stream add-on: waiting for rdx_gs_src on %s", pszPath );
+		}
+
+		bool StreamActive() const { return m_eStream.load() == StreamState::Active; }
+
+		// the stream to a client with variable refresh (RDX_GS_FLAG_VRR in its hello, RDX_GS_VRR later): the
+		// client shows each frame on arrival and sends no vblank, so it never leads; the seat's monitor
+		// (gamescope --adaptive-sync on a vrr_capable connector) flips at the app's pace and every painted
+		// frame goes out. rdx-hostd asks for it only when the seat's monitor reports vrr_capable.
+		bool StreamVrr() const { return m_bStreamVrr.load(); }
+
+		void UpdateStreamVrr( bool bWant, const char *pszWhy )
+		{
+			const char *pszEnv = getenv( "RDX_GS_VRR" );
+			const bool bVrr = bWant && !( m_Hello.flags & RDX_GS_FLAG_TEARING ) && !( pszEnv && !strcmp( pszEnv, "0" ) );
+			if ( m_bStreamVrr.exchange( bVrr ) == bVrr && strcmp( pszWhy, "attach" ) )
+				return;
+			if ( !bVrr )
+			{
+				if ( bWant )
+					rdx_log.infof( "stream variable refresh: off (%s; RDX_GS_VRR=0 or tearing), the clock follows the input",
+					               pszWhy );
+				return;
+			}
+			gamescope::IBackendConnector *pConn = GetBackend() ? GetBackend()->GetCurrentConnector() : nullptr;
+			const bool bMonVrr = pConn && pConn->SupportsVRR();
+			rdx_log.infof( "stream variable refresh: on (%s), up to %.3f Hz; the seat's monitor %s", pszWhy,
+			               m_Hello.refresh_mhz / 1000.0,
+			               !bMonVrr ? "has no variable refresh: its fixed refresh paces the app"
+			               : cv_adaptive_sync ? "runs adaptive sync and paces the app"
+			               : "could, but adaptive sync is off (--adaptive-sync / GAMESCOPE_VRR_ENABLED): its fixed refresh paces the app" );
+		}
+
+		// steamcompmgr's relative-mouse rule for the stream's rdx_gs_src (any thread). Without an attached
+		// stream nothing is sent and the state is forgotten: the next session starts absolute and is told again.
+		void StreamSetRelativeMouse( bool bRelative )
+		{
+			if ( StreamActive() )
+				m_StreamHint.Set( this, bRelative, "stream pointer hint" );
+			else
+				m_StreamHint.Reset();
+		}
+
+		// paint thread: state changes that need Vulkan, then a free slot (nullptr: none / inactive)
+		gamescope::Rc<CVulkanTexture> StreamBegin( int *pnSlot )
+		{
+			std::unique_lock<std::mutex> lock( m_StreamMutex );
+			const StreamState eState = m_eStream.load();
+			if ( eState == StreamState::Attaching )
+			{
+				m_uRowPitch = 0;
+				m_uFreeMask = 0;
+				m_uLastSlot = m_Hello.nslots - 1;
+				m_ulStreamFrames = 0;
+				const bool bSameGpu = StreamSameGpu();
+				if ( bSameGpu && ImportSlots() )      // ACK sent; rdx_gs_src then frees every slot
+				{
+					UpdateStreamVrr( ( m_Hello.flags & RDX_GS_FLAG_VRR ) != 0, "attach" );
+					m_eStream = StreamState::Active;
+					rdx_log.infof( "stream attached: %ux%u @ %.3f Hz, %u %s slots, clock: %s", m_Hello.width, m_Hello.height,
+					               m_Hello.refresh_mhz / 1000.0, m_Hello.nslots,
+					               m_Hello.buf_kind == RDX_GS_BUF_HOST ? "host" : "VRAM",
+					               m_bStreamVrr.load() ? "the monitor (variable refresh on both screens)" : RdxClockMode() );
+				}
+				else
+				{
+					if ( !bSameGpu )
+						SendAck( 0, -ENODEV );
+					ReleaseSlots();
+					shutdown( m_nSocket, SHUT_RDWR );
+					m_eStream = StreamState::Detaching;
+				}
+				m_StreamCv.notify_all();
+				return nullptr;
+			}
+			if ( eState == StreamState::Detaching )
+			{
+				ReleaseSlots();
+				m_eStream = StreamState::Idle;
+				m_StreamCv.notify_all();
+				return nullptr;
+			}
+			if ( eState != StreamState::Active )
+				return nullptr;
+			lock.unlock();
+			if ( m_bReconfig.load() )
+			{
+				ApplyReconfig();
+				return nullptr;
+			}
+			int nSlot = TakeFreeSlot();
+			if ( nSlot < 0 )
+			{
+				m_ulNoSlot++;
+				return nullptr;
+			}
+			*pnSlot = nSlot;
+			return m_pSlotTex[ nSlot ];
+		}
+
+		// paint thread: the stream composite of slot nSlot was submitted (oSeq) -> host copy, READY
+		void StreamEnd( int nSlot, std::optional<uint64_t> oSeq, uint64_t ulBegin )
+		{
+			if ( oSeq && m_HostBuffer[ nSlot ] != VK_NULL_HANDLE )
+				oSeq = CopyToHost( nSlot );
+			if ( !oSeq )
+			{
+				GiveSlot( nSlot );
+				return;
+			}
+			vulkan_wait( *oSeq, true );
+			const uint64_t ulDone = get_time_in_nanos();
+			rdx_gs_msg msg = {
+				.magic = RDX_GS_MAGIC, .type = RDX_GS_READY, .slot = (uint32_t)nSlot, .pad = m_uGen,
+				.seq = m_ulFrames++, .t_ns = ulDone, .t_begin_ns = ulBegin,
+			};
+			if ( send( m_nSocket, &msg, sizeof( msg ), MSG_NOSIGNAL ) != (ssize_t)sizeof( msg ) )
+				GiveSlot( nSlot );       // rdx_gs_src is going away; the receive loop sees it
+			m_ulStreamFrames++;
+		}
+
+		uint32_t StreamWidth() const { return m_Hello.width; }
+		uint32_t StreamRefresh() const { return m_Hello.refresh_mhz; }
+		uint32_t StreamHeight() const { return m_Hello.height; }
+
+	private:
+		enum class StreamState { Idle, Attaching, Active, Detaching };
+
+		// the slots of rdx_gs_src live on (or are written by) its GPU: it must be ours
+		bool StreamSameGpu()
+		{
+			VkPhysicalDeviceIDProperties idProps = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES };
+			VkPhysicalDeviceProperties2 props = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, .pNext = &idProps };
+			g_device.vk.GetPhysicalDeviceProperties2( g_device.physDev(), &props );
+			if ( memcmp( idProps.deviceUUID, m_Hello.gpu_uuid, VK_UUID_SIZE ) == 0 )
+				return true;
+			rdx_log.errorf( "stream refused: rdx_gs_src uses another GPU than %s (rdx_gs_src --gpu <this GPU>)",
+			                props.properties.deviceName );
+			return false;
+		}
+
+		// waits for the paint thread to leave eState (it runs at least at every repaint we ask for)
+		void StreamWaitPaint( StreamState eState )
+		{
+			std::unique_lock<std::mutex> lock( m_StreamMutex );
+			while ( m_bRunning && m_eStream.load() == eState )
+			{
+				force_repaint();
+				m_StreamCv.wait_for( lock, std::chrono::milliseconds( 100 ) );
+			}
+		}
+
+		void StreamThread()
+		{
+			pthread_setname_np( pthread_self(), "gamescope-rdxs" );
+			while ( m_bRunning )
+			{
+				if ( !Connect( m_strStreamPath.c_str(), true ) )
+				{
+					if ( m_nSocket >= 0 )          // connected, but no valid hello
+					{
+						close( m_nSocket );
+						m_nSocket = -1;
+					}
+					std::unique_lock<std::mutex> lock( m_StreamMutex );
+					m_StreamCv.wait_for( lock, std::chrono::milliseconds( 500 ) );
+					continue;
+				}
+				m_eStream = StreamState::Attaching;
+				StreamWaitPaint( StreamState::Attaching );
+				if ( m_eStream.load() == StreamState::Active )
+					RecvLoop();
+				rdx_log.infof( "stream detached (%llu frames, %llu without a free slot)",
+				               (unsigned long long)m_ulStreamFrames, (unsigned long long)m_ulNoSlot );
+				if ( m_eStream.load() == StreamState::Active )
+					m_eStream = StreamState::Detaching;
+				StreamWaitPaint( StreamState::Detaching );
+				close( m_nSocket );
+				m_nSocket = -1;
+				m_ulNoSlot = 0;
+			}
+		}
+
+		void InputThread()
+		{
+			pthread_setname_np( pthread_self(), "gamescope-rdx-in" );
+			pollfd p[ 4 ] = { { .fd = m_nInputStop[ 0 ], .events = POLLIN },
+			                  { .fd = m_pLibInput ? m_pLibInput->GetFD() : -1, .events = POLLIN },
+			                  { .fd = m_pLibInputPrivate ? m_pLibInputPrivate->GetFD() : -1, .events = POLLIN },
+			                  { .fd = m_nInputWake[ 0 ], .events = POLLIN } };
+			// no event before the Wayland server runs: its seat does not exist yet, and a mouse that
+			// already moves (a client's streamed mouse, another session's on seat0) crashed gamescope in
+			// wlr_relative_pointer_manager_v1_send_relative_motion (NULL seat; the SDL backend waits too)
+			while ( m_bRunning && !wlserver.bWaylandServerRunning )
+			{
+				if ( poll( p, 1, 50 ) > 0 && p[ 0 ].revents )
+					return;
+			}
+			while ( m_bRunning && wlserver.bWaylandServerRunning )
+			{
+				if ( poll( p, 4, -1 ) < 0 && errno != EINTR )
+					break;
+				if ( p[ 0 ].revents )
+					break;
+				if ( p[ 3 ].revents & POLLIN )
+				{
+					// RDX_GS_INPUT: detached = every device closed and its grab released, so the gamescope
+					// of the app in the stream gets the client's devices alone (rdma-display hostd
+					// "suspend_multi" looks for the marker in this line's format)
+					char b[ 16 ];
+					while ( read( m_nInputWake[ 0 ], b, sizeof( b ) ) > 0 )
+						;
+					const bool bWant = m_bInputWanted.load();
+					if ( bWant != m_bInputOn )
+					{
+						m_bInputOn = bWant;
+						if ( m_pLibInput )
+							m_pLibInput->Suspend( !bWant );
+						if ( m_pLibInputPrivate )
+							m_pLibInputPrivate->Suspend( !bWant );
+						rdx_log.infof( "input: %s (RDX_GS_INPUT v1)", bWant ? "reading the client's devices again (stream attached)"
+						                                                    : "every device let go (stream detached, the app waits in the background)" );
+					}
+				}
+				if ( p[ 1 ].revents & POLLIN )
+					m_pLibInput->OnPollIn();
+				if ( p[ 2 ].revents & POLLIN )
+					m_pLibInputPrivate->OnPollIn();
+			}
+		}
+
+		int TakeFreeSlot()
+		{
+			// round robin from the last slot, so the client sees slots in order
+			uint32_t uMask = m_uFreeMask.load();
+			for ( uint32_t k = 1; k <= m_Hello.nslots; k++ )
+			{
+				uint32_t s = ( m_uLastSlot + k ) % m_Hello.nslots;
+				if ( uMask & ( 1u << s ) )
+				{
+					m_uFreeMask.fetch_and( ~( 1u << s ) );
+					m_uLastSlot = s;
+					return (int)s;
+				}
+			}
+			return -1;
+		}
+		void GiveSlot( int nSlot ) { m_uFreeMask.fetch_or( 1u << nSlot ); }
+
+		CRdxConnector m_Connector;
+		rdx_gs_hello m_Hello{};
+		int m_nSocket = -1;
+		int m_nSlotFds[ RDX_GS_MAX_SLOTS ] = {};
+		VkImage m_Images[ RDX_GS_MAX_SLOTS ] = {};
+		VkDeviceMemory m_Memory[ RDX_GS_MAX_SLOTS ] = {};
+		OwningRc<CVulkanTexture> m_pSlotTex[ RDX_GS_MAX_SLOTS ];
+		void *m_pHostMap[ RDX_GS_MAX_SLOTS ] = {};
+		VkBuffer m_HostBuffer[ RDX_GS_MAX_SLOTS ] = {};
+		uint32_t m_uRowPitch = 0;
+		PFN_vkCmdCopyImageToBuffer m_pfnCopyImageToBuffer = nullptr;
+		std::atomic<uint32_t> m_uFreeMask = { 0 };
+		uint32_t m_uLastSlot = RDX_GS_MAX_SLOTS - 1;
+		uint64_t m_ulFrames = 0;
+		uint64_t m_ulNoSlot = 0;
+		uint64_t m_ulLastShape = 0;
+		std::mutex m_ReconfigMutex;
+		std::atomic<bool> m_bReconfig = { false };
+		rdx_gs_hello m_PendingHello{};
+		int m_nPendingFds[ RDX_GS_MAX_SLOTS ] = {};
+		uint32_t m_uGen = 0;
+		int m_nShapeLogs = 0;
+		std::atomic<bool> m_bVrr = { false };      // RDX_GS_FLAG_VRR in effect (UpdateVrr)
+		std::atomic<bool> m_bStreamVrr = { false };    // stream add-on: the client has variable refresh (UpdateStreamVrr)
+		uint64_t m_ulLastFlip = 0;                 // paint thread: the last variable refresh "flip" (MarkVrrFlip)
+		bool m_bVrrAppOffLogged = false;
+		std::atomic<bool> m_bVrrChange = { false };     // RDX_GS_VRR received, ApplyVrrChange pending
+		std::atomic<bool> m_bPendingVrrOn = { false };
+		std::atomic<uint32_t> m_uPendingVrrMhz = { 0 };
+		std::atomic<bool> m_bRunning = { true };
+		std::thread m_RecvThread;
+		std::unique_ptr<CLibInputHandler> m_pLibInput;
+		std::unique_ptr<CLibInputHandler> m_pLibInputPrivate;
+		int m_nInputStop[ 2 ] = { -1, -1 };
+		int m_nInputWake[ 2 ] = { -1, -1 };          // RDX_GS_INPUT wakes the input thread
+		std::atomic<bool> m_bInputWanted = { true };
+		bool m_bInputOn = true;                      // input thread only
+		std::thread m_InputThread;
+
+		const bool m_bStream = false;
+		std::string m_strStreamPath;
+		std::thread m_StreamThread;
+		std::mutex m_StreamMutex;
+		std::condition_variable m_StreamCv;
+		std::atomic<StreamState> m_eStream = { StreamState::Idle };
+		uint64_t m_ulStreamFrames = 0;
+		CRdxHintSender m_StreamHint;
+
+		// the cursor next to the picture
+		std::atomic<bool> m_bCursorSep = { false };
+		std::atomic<bool> m_bCursorResync = { false };
+		std::mutex m_CursorMutex;                  // the CURIMG / CURPOS packets in order, the state below
+		std::shared_ptr<INestedHints::CursorInfo> m_pCursorInfo;
+		uint32_t m_uCursorSerial = 0;
+		bool m_bCursorImagePending = false;
+		uint32_t m_uCursorImageOff = 0;            // the next chunk of a picture the socket did not take whole
+		bool m_bCursorLogged = false;
+		bool m_bCursorSent = false;                // the last CURPOS: what the client knows
+		int32_t m_nCursorX = 0, m_nCursorY = 0;
+		bool m_bCursorVisible = false;
+		uint32_t m_uCursorSentSerial = 0;
+	};
+
+	// X11 apps (Steam's steamwebhelper/Chromium, Proton games) reach us through Xwayland. On
+	// NVIDIA there is no implicit sync, so without explicit sync we may sample an X11 window's
+	// buffer before the GPU has finished drawing it: whole frames of the clear colour (black or
+	// white) between real ones, i.e. heavy flicker in continuous animations such as Steam's
+	// screen saver (measured on a client: 1029 black + 82 white of 1554 frames).
+	// Xwayland >= 24.1 passes wp_linux_drm_syncobj_v1 acquire/release points, which gamescope
+	// takes wherever the backend supports explicit sync (rdx, DRM). Distributions with an older
+	// Xwayland (Ubuntu 24.04: 23.2) get one installed next to gamescope; wlroots starts it via
+	// WLR_XWAYLAND. Called by main() for every backend (the seat's own monitor runs DRM).
+	void RdxPickXwayland()
+	{
+		if ( const char *pszSet = getenv( "WLR_XWAYLAND" ); pszSet && *pszSet )
+		{
+			rdx_log.infof( "Xwayland: %s (WLR_XWAYLAND)", pszSet );
+			return;
+		}
+		char szPath[ PATH_MAX ];
+		ssize_t n = readlink( "/proc/self/exe", szPath, sizeof( szPath ) - 16 );
+		char *pszSlash = n > 0 ? (char *)memrchr( szPath, '/', (size_t)n ) : nullptr;
+		if ( pszSlash )
+		{
+			strcpy( pszSlash + 1, "Xwayland" );
+			if ( access( szPath, X_OK ) == 0 )
+			{
+				setenv( "WLR_XWAYLAND", szPath, 1 );
+				rdx_log.infof( "Xwayland: %s (next to gamescope, explicit sync)", szPath );
+				return;
+			}
+		}
+		rdx_log.infof( "Xwayland: the system's (no Xwayland next to gamescope); before 24.1 it has no "
+		               "explicit sync, and X11 apps on NVIDIA may flicker" );
+	}
+
+	/////////////////////////
+	// Stream add-on and clock
+	/////////////////////////
+
+	static CRdxBackend *s_pRdxStream = nullptr;
+	// 1: the last keyboard/pointer/touch event came from rdx_input_rx (the client), 0: local
+	static std::atomic<int> s_nRdxInputRemote = { 0 };
+	// RDX_GS_CLOCK=client|monitor pins the clock (tests, or a seat whose inputs cannot be told
+	// apart); unset/auto: the side of the last input
+	static int s_nRdxClockPinned = -1;
+
+	void RdxStreamInit( bool bRdxBackend )
+	{
+		const char *pszPath = getenv( "RDX_GS_STREAM_SOCKET" );
+		if ( bRdxBackend || !pszPath || !*pszPath )
+			return;
+		if ( const char *pszClock = getenv( "RDX_GS_CLOCK" ) )
+			s_nRdxClockPinned = !strcmp( pszClock, "client" ) ? 1 : !strcmp( pszClock, "monitor" ) ? 0 : -1;
+		s_pRdxStream = new CRdxBackend( true );
+		s_pRdxStream->StartStream( pszPath );
+	}
+
+	void RdxNoteInput( const char *pszDevice )
+	{
+		const int nRemote = pszDevice && !strncmp( pszDevice, "rdx:", 4 ) ? 1 : 0;
+		if ( s_nRdxInputRemote.exchange( nRemote ) != nRemote && s_pRdxStream && s_pRdxStream->StreamActive() )
+			rdx_log.infof( "clock: the %s leads (input from %s)", nRemote ? "client" : "monitor", pszDevice ? pszDevice : "?" );
+	}
+
+	const char *RdxClockMode()
+	{
+		return s_nRdxClockPinned == 1 ? "client (RDX_GS_CLOCK)" : s_nRdxClockPinned == 0 ? "monitor (RDX_GS_CLOCK)"
+		                                                                 : "the side of the last input";
+	}
+
+	int RdxLeadingClientRefresh()
+	{
+		return RdxClientLeads() ? (int)s_pRdxStream->StreamRefresh() : 0;
+	}
+
+	bool RdxGrabInput()
+	{
+		static const bool s_bGrab = []()
+		{
+			const char *pszGrab = getenv( "RDX_GS_GRAB" );
+			const bool bGrab = !( pszGrab && !strcmp( pszGrab, "0" ) );
+			rdx_log.infof( "input: %s", bGrab ? "keyboards and pointers grabbed (EVIOCGRAB): no other reader, "
+			                                    "not the host's console, sees them" : "not grabbed (RDX_GS_GRAB=0)" );
+			return bGrab;
+		}();
+		return s_bGrab;
+	}
+
+	void RdxGrabEvdev( int nFd, const char *pszWhat, bool bClientOnly )
+	{
+		if ( nFd < 0 || !RdxGrabInput() )
+			return;
+		auto testBit = []( const uint8_t *pBits, unsigned n ) { return ( pBits[ n / 8 ] >> ( n % 8 ) ) & 1; };
+		uint8_t keys[ KEY_CNT / 8 + 1 ] = {}, rels[ REL_CNT / 8 + 1 ] = {};
+		char szName[ 128 ] = "";
+		if ( ioctl( nFd, EVIOCGBIT( EV_KEY, sizeof( keys ) ), keys ) < 0 )
+			return;                                          // not an evdev node
+		ioctl( nFd, EVIOCGBIT( EV_REL, sizeof( rels ) ), rels );
+		ioctl( nFd, EVIOCGNAME( sizeof( szName ) - 1 ), szName );
+		bool bJoystick = false, bKeys = false;
+		for ( unsigned k = BTN_JOYSTICK; k < BTN_DIGI; k++ )            // joystick and gamepad buttons
+			bJoystick |= testBit( keys, k );
+		for ( unsigned k = KEY_ESC; k < BTN_MISC; k++ )                 // what the VT keyboard handler takes
+			bKeys |= testBit( keys, k );
+		const bool bPointer = testBit( rels, REL_X ) || testBit( keys, BTN_LEFT );
+		if ( bJoystick || !( bKeys || bPointer ) )
+			return;
+		if ( bClientOnly )
+		{
+			// the client's devices only: rdx_input_rx's mirrors and a local window's ("rdx: ..."),
+			// rdx_usb_host's uhid devices (phys "rdx:..."), USB/IP (vhci_hcd). Other virtual devices
+			// (Steam Input's, a desktop's own tools) are read as before but never taken away
+			struct stat st;
+			char szSys[ 64 ], szReal[ PATH_MAX ] = "", szPhys[ 128 ] = "";
+			ioctl( nFd, EVIOCGPHYS( sizeof( szPhys ) - 1 ), szPhys );
+			if ( fstat( nFd, &st ) == 0 )
+			{
+				snprintf( szSys, sizeof( szSys ), "/sys/dev/char/%u:%u", major( st.st_rdev ), minor( st.st_rdev ) );
+				if ( !realpath( szSys, szReal ) )
+					szReal[ 0 ] = 0;
+			}
+			if ( strncmp( szName, "rdx:", 4 ) && strncmp( szPhys, "rdx:", 4 ) && !strstr( szReal, "/vhci_hcd" ) )
+				return;
+		}
+		for ( int i = 0; ; i++ )
+		{
+			if ( ioctl( nFd, EVIOCGRAB, 1 ) == 0 )
+			{
+				rdx_log.infof( "input: grabbed \"%s\" (%s)", szName, pszWhat );
+				return;
+			}
+			if ( errno != EBUSY )
+				break;
+			// ours already (wlroots: a keyboard and a pointer of one device share the fd)? Releasing
+			// works only for the holder
+			if ( ioctl( nFd, EVIOCGRAB, 0 ) == 0 )
+			{
+				ioctl( nFd, EVIOCGRAB, 1 );
+				return;
+			}
+			errno = EBUSY;
+			if ( i >= 250 )                    // up to 0.5 s: probes of rdx_input_rx and seatmgr under load
+				break;
+			usleep( 2000 );
+		}
+		rdx_log.errorf( "input: could not grab \"%s\" (%s): %s; the host's console may see its keys",
+		                szName, pszWhat, strerror( errno ) );
+	}
+
+	bool RdxClientLeads()
+	{
+		if ( !s_pRdxStream || !s_pRdxStream->StreamActive() )
+			return false;
+		if ( s_pRdxStream->StreamVrr() )   // a variable refresh client sends no vblank: the monitor paces
+			return false;
+		return s_nRdxClockPinned >= 0 ? s_nRdxClockPinned == 1 : s_nRdxInputRemote.load() == 1;
+	}
+
+	gamescope::Rc<CVulkanTexture> RdxStreamBegin( int *pnSlot, uint32_t *puWidth, uint32_t *puHeight )
+	{
+		if ( !s_pRdxStream )
+			return nullptr;
+		gamescope::Rc<CVulkanTexture> pTex = s_pRdxStream->StreamBegin( pnSlot );
+		if ( pTex )
+		{
+			*puWidth = s_pRdxStream->StreamWidth();
+			*puHeight = s_pRdxStream->StreamHeight();
+		}
+		return pTex;
+	}
+
+	void RdxStreamEnd( int nSlot, std::optional<uint64_t> oSeq, uint64_t ulBegin )
+	{
+		if ( s_pRdxStream )
+			s_pRdxStream->StreamEnd( nSlot, oSeq, ulBegin );
+	}
+
+	void RdxStreamSetRelativeMouse( bool bRelative )
+	{
+		if ( s_pRdxStream )
+			s_pRdxStream->StreamSetRelativeMouse( bRelative );
+	}
